{
  "manifest_version": 3,
  "name": "YouTube Sentiment Analyzer - MLOps",
  "version": "1.0.0",
  "description": "Analyse de sentiment en temps réel des commentaires YouTube propulsée par une API ML dans le Cloud.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Sentiment Analyzer"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:7860/*",
    "http://127.0.0.1:7860/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
